# Optional AI provider keys. The app works without these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY= also works as a Google fallback.

# Local Ollama default. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Electron/Vite development only. Normally set by npm run dev.
VITE_DEV_SERVER_URL=
